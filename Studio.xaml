<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="OG Mastering · Suno Studio" Width="1500" Height="940" MinWidth="1120" MinHeight="760" Background="#080910" Foreground="#EFF3FA" WindowStartupLocation="CenterScreen" AllowDrop="True">
 <Window.Resources>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="#090B13"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#283142" CornerRadius="4" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EAF0FA"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#14151F"/><Setter Property="Foreground" Value="#A4B3CE"/><Setter Property="Padding" Value="13,9"/><Setter Property="Margin" Value="0,0,7,0"/><Setter Property="BorderBrush" Value="#262733"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#12CDE8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#899BB9"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,8,0,9"/></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#D8E4F7"/><Setter Property="Background" Value="#13141F"/><Setter Property="Padding" Value="10,8"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,7,0,12"/><Setter Property="Foreground" Value="#E8F1FF"/><Setter Property="Background" Value="#13141E"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#13141E" BorderBrush="#2C2D3A" BorderThickness="1" CornerRadius="11" Padding="12,11"><DockPanel><TextBlock Text="⌄" Foreground="#9CABC3" DockPanel.Dock="Right" HorizontalAlignment="Right"/><ContentPresenter TextElement.Foreground="#E8F1FF" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" VerticalAlignment="Center"/></DockPanel></Border></ControlTemplate></ToggleButton.Template></ToggleButton><Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide"><Border Background="#13141F" BorderBrush="#2B3546" BorderThickness="1" CornerRadius="8" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320"><ScrollViewer><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Slider"><Setter Property="Margin" Value="0,7,0,12"/><Setter Property="IsSnapToTickEnabled" Value="True"/><Setter Property="Foreground" Value="#11CEE9"/></Style>
  <Style TargetType="Expander"><Setter Property="Foreground" Value="#A4B3CE"/><Setter Property="Margin" Value="0,7,0,7"/><Setter Property="Padding" Value="7"/></Style>
 </Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border BorderBrush="#181A25" BorderThickness="0,0,0,1"><Grid Margin="24,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="OG" FontSize="23" FontWeight="Black" Foreground="#13D4EC"/><TextBlock Text=" / MASTERING" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,0,0"/><TextBlock Text="SUNO STUDIO" FontSize="9" Foreground="#5B6E8D" VerticalAlignment="Center" Margin="14,0,0,0"/></StackPanel><Border Background="#10151E" BorderBrush="#26303A" BorderThickness="1" CornerRadius="17" Padding="4" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Button x:Name="SingleMode" Content="Single Track" Background="#103346" Foreground="White" BorderBrush="#0AA9C6" Padding="22,7"/><Button x:Name="BulkMode" Content="Bulk" Padding="23,7" Background="Transparent" BorderThickness="0"/><Button x:Name="PresetsMode" Content="▦  Presets" Padding="20,7" Background="Transparent" BorderThickness="0" Margin="0"/></StackPanel></Border><TextBlock Text="●  LOCAL AUDIO ENGINE" Foreground="#518496" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border BorderBrush="#171A24" BorderThickness="0,0,1,0" Padding="12"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Border Background="#0A0B13" BorderBrush="#20212D" BorderThickness="1" CornerRadius="16" Padding="16"><StackPanel>
    <TextBlock Text="⚒  MASTERING CONTROLS" Foreground="#0FD9F4" FontSize="12" FontWeight="Bold" Margin="0,0,0,17"/>
    <TextBlock Text="GENRE" Foreground="#637592" FontSize="9"/>
    <ComboBox x:Name="Preset" SelectedIndex="0"><ComboBoxItem Content="Suno / balanced"/><ComboBoxItem Content="Pop / vocal"/><ComboBoxItem Content="Hip-hop / R&amp;B"/><ComboBoxItem Content="Electronic / dance"/><ComboBoxItem Content="Rock / heavy"/><ComboBoxItem Content="Acoustic / folk"/><ComboBoxItem Content="Ambient / cinematic"/><ComboBoxItem Content="Bypass cleanup / manual"/></ComboBox>
    <TextBlock Text="STYLE" Foreground="#637592" FontSize="9" Margin="0,5,0,8"/><UniformGrid x:Name="StyleButtons" Columns="3" Rows="2" Margin="0,0,0,12"/>
    <Border Background="#08121B" BorderBrush="#123344" BorderThickness="1" CornerRadius="14" Padding="12"><StackPanel><TextBlock Text="LOUDNESS TARGET" FontSize="9" HorizontalAlignment="Center"/><StackPanel x:Name="TargetControl"/><TextBlock Text="Custom loudness target" Foreground="#607493" FontSize="10" HorizontalAlignment="Center"/></StackPanel></Border>
    <Border Background="#0E0E18" BorderBrush="#242430" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,12,0,5"><StackPanel><TextBlock Text="♫  REFERENCE TRACK" Foreground="#7183A0" FontSize="10" FontWeight="Bold" Margin="0,0,0,10"/><Button x:Name="Reference" Content="↑  Upload reference for tone matching" FontSize="10" Padding="7,10" Margin="0"/><TextBlock x:Name="ReferenceInfo" Text="Optional · local processing" Foreground="#5D708D" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/><Button x:Name="ClearReference" Content="Clear reference" IsEnabled="False" FontSize="9" Padding="6,3" Margin="0,8,0,0" HorizontalAlignment="Left"/></StackPanel></Border>
    <Expander x:Name="AdvancedPanel" Header="⚙  ADVANCED SETTINGS"><StackPanel>
     <StackPanel Visibility="Collapsed"><StackPanel x:Name="CleanupControls"/><StackPanel x:Name="ToneControls"/></StackPanel>
     <StackPanel x:Name="AdvancedCards" Margin="0,12,0,0"/>
     <Expander Header="Export format / reference"><StackPanel x:Name="OutputControls"/></Expander>
    </StackPanel></Expander>
    <Expander x:Name="PresetPanel" Header="▦  SAVE / LOAD PRESET"><StackPanel><TextBlock Text="Store your current settings locally as a JSON preset." TextWrapping="Wrap" Foreground="#6F819D" FontSize="10" Margin="0,8,0,12"/><WrapPanel><Button x:Name="SavePreset" Content="Save preset" FontSize="11"/><Button x:Name="LoadPreset" Content="Load preset" FontSize="11"/></WrapPanel></StackPanel></Expander>
    <TextBlock Text="OFFLINE  /  PRIVATE  /  YOURS" Foreground="#41556F" FontSize="9" Margin="0,16,0,2" HorizontalAlignment="Center"/>
   </StackPanel></Border></ScrollViewer></Border>
   <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="16"><Border Background="#0A0B13" BorderBrush="#124354" BorderThickness="1" CornerRadius="16" Padding="16"><StackPanel>
    <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="TrackName" Text="Your next release starts here." FontSize="16" FontWeight="Bold"/><TextBlock x:Name="TrackInfo" Text="Drop a Suno export here · WAV, MP3, FLAC, M4A, AIFF, OGG" FontSize="11" Foreground="#667B9B" Margin="0,5,15,0" TextTrimming="CharacterEllipsis"/></StackPanel><Button x:Name="Import" Grid.Column="1" Content="+  Choose song" Padding="15,9" Margin="0"/></Grid>
    <TextBlock Text="TRACK TYPE" Foreground="#647999" FontSize="9" Margin="0,0,0,7"/><UniformGrid Columns="3" Margin="0,0,0,9"><Button x:Name="VocalsType" Padding="14,12"><StackPanel><TextBlock Text="🎙  Has vocals" HorizontalAlignment="Center" FontWeight="SemiBold"/><TextBlock Text="Apply gentle de-essing" Foreground="#647C9F" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></Button><Button x:Name="InstrumentalType" Padding="14,12"><StackPanel><TextBlock Text="♫  Instrumental" HorizontalAlignment="Center" FontWeight="SemiBold"/><TextBlock Text="Start with de-essing off" Foreground="#647C9F" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></Button><Button x:Name="AnalyzeTrack" ToolTip="Measure loudness, peaks, dynamics and frequency balance" Padding="14,12" Margin="0"><StackPanel><TextBlock Text="⌕  Auto Detect" HorizontalAlignment="Center" FontWeight="SemiBold"/><TextBlock Text="Suggest genre and vocals" Foreground="#647C9F" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></Button></UniformGrid>
    <TextBlock x:Name="GenreInfo" Text="Genre: Suno / balanced · choose a starting point on the left" Foreground="#627998" FontSize="10" Margin="0,2,0,13"/>
    <Border Background="#101019" BorderBrush="#232330" BorderThickness="1" CornerRadius="15" Padding="12"><StackPanel><DockPanel><TextBlock Text="QUICK ADJUST" FontSize="11" FontWeight="Bold"/><Button x:Name="ResetQuick" Content="Reset" HorizontalAlignment="Right" DockPanel.Dock="Right" Padding="9,3" Margin="0" FontSize="9"/></DockPanel><UniformGrid x:Name="QuickControls" Columns="9" Margin="0,7,0,0"/></StackPanel></Border>
    <Border Background="#0A0B14" BorderBrush="#20212C" BorderThickness="1" CornerRadius="15" Margin="0,12,0,0" Padding="10"><StackPanel><DockPanel><TextBlock x:Name="WaveVersion" Text="ORIGINAL" Foreground="#91A1B9" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="WaveStatus" Text="Import a song to see its waveform" Foreground="#526580" FontSize="10" HorizontalAlignment="Right"/></DockPanel><Grid x:Name="WaveHost" Height="140" Margin="0,6,0,0" ClipToBounds="True" Background="Transparent" Cursor="Hand"><Border Height="1" Background="#1D2535" VerticalAlignment="Center"/><Image x:Name="WaveImage" Stretch="Fill"/><Border x:Name="Playhead" Background="#14D7ED" Width="1" HorizontalAlignment="Left" Opacity="0.8"/></Grid></StackPanel></Border>
    <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions><Button x:Name="Original" Content="▶  Original" IsEnabled="False" Background="#20222D" Foreground="White"/><Button x:Name="Mastered" Grid.Column="1" Content="▶  Mastered" IsEnabled="False"/><Button x:Name="Stop" Grid.Column="2" Content="■" Margin="0" Padding="5,9"/></Grid>
    <Slider x:Name="Seek" Minimum="0" Maximum="1" Value="0" TickFrequency="0.1" IsSnapToTickEnabled="False" Margin="0,7,0,0"/>
    <DockPanel><TextBlock x:Name="PlaybackTime" Text="00:00 / 00:00" Foreground="#627B9D" FontSize="10"/><CheckBox x:Name="LevelMatch" Content="Level-match A/B" IsChecked="True" HorizontalAlignment="Right" Margin="0,0,0,0"/></DockPanel>
    <UniformGrid Columns="4" Margin="0,12,0,0"><Border Background="#11111C" BorderBrush="#232330" BorderThickness="1" CornerRadius="13" Padding="10" Margin="0,0,7,0"><StackPanel><TextBlock Text="SOURCE LUFS" FontSize="9" Foreground="#8295B2" HorizontalAlignment="Center"/><TextBlock x:Name="InputMeter" Text="— LUFS" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel></Border><Border Background="#11111C" BorderBrush="#232330" BorderThickness="1" CornerRadius="13" Padding="10" Margin="0,0,7,0"><StackPanel><TextBlock Text="MASTER LUFS" FontSize="9" Foreground="#8295B2" HorizontalAlignment="Center"/><TextBlock x:Name="OutputMeter" Text="— LUFS" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel></Border><Border Background="#11111C" BorderBrush="#232330" BorderThickness="1" CornerRadius="13" Padding="10" Margin="0,0,7,0"><StackPanel><TextBlock Text="TRUE PEAK" FontSize="9" Foreground="#8295B2" HorizontalAlignment="Center"/><TextBlock x:Name="PeakMeter" Text="— dBTP" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel></Border><Border Background="#11111C" BorderBrush="#232330" BorderThickness="1" CornerRadius="13" Padding="10"><StackPanel><TextBlock Text="LOUDNESS RANGE" FontSize="9" Foreground="#8295B2" HorizontalAlignment="Center"/><TextBlock x:Name="RangeMeter" Text="— LU" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel></Border></UniformGrid>
    <Grid Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="Stage" Text="Ready when you are" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="Status" Text="Choose a song, shape your sound, then master and export." FontSize="10" Foreground="#7489A8" TextWrapping="Wrap" Margin="0,4,15,0"/></StackPanel><StackPanel Orientation="Horizontal" Grid.Column="1"><Button x:Name="Render" Content="MASTER &amp; EXPORT  ↓" IsEnabled="False" Background="#0B3744" Foreground="#19DDF4" BorderBrush="#0B9EB6" FontWeight="Bold"/><Button x:Name="Cancel" Content="Cancel" IsEnabled="False" Margin="0"/></StackPanel></Grid>
    <ProgressBar x:Name="Progress" Height="3" Margin="0,10,0,0" Background="#1A2533" Foreground="#13CDE6" Minimum="0" Maximum="100"/>
    <TextBlock x:Name="PlaybackStatus" Text="Space: stop · A: original · B: master" Foreground="#4F6584" FontSize="9" Margin="0,8,0,0"/>
    <Expander Header="MASTERING ADVISOR / EXPORT REPORT" Margin="0,14,0,0"><StackPanel><TextBlock x:Name="Advice" Text="Export a master to see measured loudness, peak checks, and practical suggestions." Foreground="#8FA4C1" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/><TextBlock x:Name="MatchInfo" Text="" Foreground="#34BCCF" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,10"/><WrapPanel><Button x:Name="SaveReport" Content="Save report" IsEnabled="False"/><Button x:Name="Folder" Content="Open export folder" IsEnabled="False"/></WrapPanel></StackPanel></Expander>
   </StackPanel></Border></ScrollViewer>
  </Grid>
 </Grid>
</Window>
